datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  ANALYST
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password_hash String
  totp_secret   String?
  role          Role
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  assets        Asset[]
  form_accesses UserFormAccess[]
}

enum ConfirmationMode {
  SIMPLE
  CODE
  TICKET
}

enum FolioStrategy {
  NONE
  CONSECUTIVE
  PREFIX_DATE_CONSECUTIVE
  RANDOM_CHECKSUM
}

enum ReservationStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

model FormConfig {
  id              String           @id @default(uuid()) @db.Uuid
  form_identifier String           @unique
  is_active       Boolean          @default(false)
  is_listed       Boolean          @default(true)
  public_password String?
  confirmation_mode ConfirmationMode @default(SIMPLE)
  
  // Novedades: Folio
  folio_strategy  FolioStrategy    @default(CONSECUTIVE)
  folio_prefix    String?
  
  // Novedades: Cupo y Reservas
  max_submissions            Int?
  reservation_window_minutes Int      @default(15)

  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  deleted_at      DateTime?
}

model FormReservation {
  id              String           @id @default(uuid()) @db.Uuid
  form_identifier String
  status          ReservationStatus @default(PENDING)
  expires_at      DateTime
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@index([form_identifier, status])
}

model UserFormAccess {
  user_id         String   @db.Uuid
  form_identifier String
  created_at      DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, form_identifier])
}

model Asset {
  id            String    @id @default(uuid()) @db.Uuid
  original_name String
  mime_type     String
  size_bytes    Int
  uploaded_by   String?   @db.Uuid
  user          User?     @relation(fields: [uploaded_by], references: [id])
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
}

enum ViewType {
  TABLE
  CHART
}

model CustomView {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  type            ViewType
  configuration   Json
  is_public       Boolean   @default(false)
  public_password String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
}

enum ActivityType {
  HORA_DEL_CUENTO
  CIRCULO_DE_LECTURA
  TALLER
}

enum Gender {
  H
  M
}

enum Occupation {
  HOGAR
  ESTUDIANTE
  TRABAJADOR
  JUBILADO
  DESOCUPADO
}

enum EducationLevel {
  PREESCOLAR
  PRIMARIA
  SECUNDARIA
  BACHILLERATO
  LICENCIATURA
  POSGRADO
}

enum ContactRelation {
  PADRE
  MADRE
  TUTOR
  OTRO_FAMILIAR
  OTRO
}

model EventRegistration {
  id String @id @default(uuid()) @db.Uuid
  folio String? @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  // Información General
  activity ActivityType
  activity_date DateTime

  // Información del Participante
  participant_name String
  participant_birthdate DateTime
  participant_gender Gender
  participant_email String?
  participant_phone String?
  participant_neighborhood String?
  participant_occupation Occupation
  participant_education EducationLevel
  needs_disability_support Boolean
  has_library_loan_record Boolean

  // Información de Contacto
  contact1_name String?
  contact1_email String?
  contact1_phone String?
  contact1_relation ContactRelation?

  // Información de Segundo Contacto
  contact2_name String?
  contact2_email String?
  contact2_phone String?
  contact2_relation ContactRelation?

  // Autorización e Indicaciones
  accepts_image_usage Boolean
}

enum PrepaModality {
  ESCOLARIZADA
  ABIERTA
}

enum PrepaShift {
  MATUTINO
  VESPERTINO
  SABATINO
}

model PrepaStase {
  id              String   @id @default(uuid()) @db.Uuid
  folio           String?  @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  deleted_at      DateTime?

  // Datos Personales
  full_name       String
  birthdate       DateTime
  neighborhood    String
  phone           String
  email           String?

  // Datos del Tutor
  tutor_name      String?
  tutor_phone     String?

  // Datos Académicos y de Interés
  last_grade      String
  last_school     String
  modality        PrepaModality
  shift           PrepaShift
  
  // Metadatos
  contact_methods String[]
  notes           String?
}
